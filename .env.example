# Copy to .env for local dev (pocketbase/dev.sh loads it). In Dokploy set these in the Environment tab.
# Google OAuth2 client (Google Cloud Console > APIs & Services > Credentials). Both required for login.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Optional: comma-separated email domains allowed to sign in (empty = anyone with a Google account)
ALLOWED_EMAIL_DOMAINS=
